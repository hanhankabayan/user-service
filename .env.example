# medmon db config
MEDMON_DB_URI='mongodb://[username]:[password]@[domain/ip]/?replicaSet=rs-medmon&authSource=medmon'
MEDMON_DB_NAME='[db_name]'

# auth
AUTH_SECRET_KEY='example_secret_key'
AUTH_TOKEN_URL="http://example.com/auth/login"

# telegram logs
TELEGRAM_BOT_TOKEN='[bot_token]'
TELEGRAM_CHAT_ID='[chat_id]'
TELEGRAM_MESSAGE_THREAD_ID='[thread_id]'


# whitelist domain | separate with comma (,) and space
ORIGINS='http://example.com, https://another-example.com'
